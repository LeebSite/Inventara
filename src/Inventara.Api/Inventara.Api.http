@baseUrl = http://localhost:5090
@token = {{login.response.body.$.data.accessToken}}
@userId = {{registerUser.response.body.$.data.id}}
@categoryId = {{createCategory.response.body.$.data.id}}
@locationId = {{createLocation.response.body.$.data.id}}
@vendorId = {{createVendor.response.body.$.data.id}}
@assetId = {{createAsset.response.body.$.data.id}}
@loanId = {{createLoan.response.body.$.data.id}}
@rejectedLoanId = {{createRejectedLoan.response.body.$.data.id}}
@maintenanceLoanId = {{createMaintenanceLoan.response.body.$.data.id}}
@maintenanceId = {{createMaintenance.response.body.$.data.id}}

### Login with local admin credentials supplied by the REST Client environment
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Register a user (Admin only)
# @name registerUser
POST {{baseUrl}}/api/v1/auth/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Example User",
  "email": "example.user@example.test",
  "password": "{{newUserPassword}}",
  "department": "Operations",
  "phone": "0000000000",
  "role": "User"
}

### Get the current user's profile
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{token}}

### List users
GET {{baseUrl}}/api/v1/users?search=&page=1&pageSize=10&sortBy=fullName&sortDir=asc
Authorization: Bearer {{token}}

### Get a user by ID
GET {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

### Update a user
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Example User",
  "email": "example.user@example.test",
  "department": "Operations",
  "phone": "0000000000",
  "role": "User",
  "isActive": true
}

### Soft-delete a user
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

### List categories
GET {{baseUrl}}/api/v1/categories?search=&page=1&pageSize=10&sortBy=name&sortDir=asc
Authorization: Bearer {{token}}

### Create a category (Admin or Staff)
# @name createCategory
POST {{baseUrl}}/api/v1/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Category",
  "description": "Example description"
}

### Get a category by ID
GET {{baseUrl}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}

### Update a category (Admin only)
PUT {{baseUrl}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Category",
  "description": "Updated description"
}

### Soft-delete a category (Admin only)
DELETE {{baseUrl}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}

### List locations
GET {{baseUrl}}/api/v1/locations?search=&page=1&pageSize=10&sortBy=name&sortDir=asc
Authorization: Bearer {{token}}

### Create a location (Admin or Staff)
# @name createLocation
POST {{baseUrl}}/api/v1/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Location",
  "building": "Head Office",
  "floor": "1",
  "description": "Example description"
}

### Get a location by ID
GET {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}

### Update a location (Admin only)
PUT {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Location",
  "building": "Head Office",
  "floor": "2",
  "description": "Updated description"
}

### Soft-delete a location (Admin only)
DELETE {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}

### List vendors
GET {{baseUrl}}/api/v1/vendors?search=&page=1&pageSize=10&sortBy=name&sortDir=asc
Authorization: Bearer {{token}}

### Create a vendor (Admin or Staff)
# @name createVendor
POST {{baseUrl}}/api/v1/vendors
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Vendor",
  "contactPerson": "Example Contact",
  "email": "contact@example.test",
  "phone": "0000000000",
  "address": "Example address"
}

### Get a vendor by ID
GET {{baseUrl}}/api/v1/vendors/{{vendorId}}
Authorization: Bearer {{token}}

### Update a vendor (Admin only)
PUT {{baseUrl}}/api/v1/vendors/{{vendorId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Vendor",
  "contactPerson": "Example Contact",
  "email": "contact@example.test",
  "phone": "0000000000",
  "address": "Updated address"
}

### Soft-delete a vendor (Admin only)
DELETE {{baseUrl}}/api/v1/vendors/{{vendorId}}
Authorization: Bearer {{token}}

### List assets with search, filters, sorting, and pagination
GET {{baseUrl}}/api/v1/assets?search=laptop&status=Available&categoryId={{categoryId}}&locationId={{locationId}}&page=1&pageSize=10&sortBy=assetCode&sortDir=asc
Authorization: Bearer {{token}}

### Create an asset (Admin or Staff; asset code is generated)
# @name createAsset
POST {{baseUrl}}/api/v1/assets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Laptop",
  "categoryId": "{{categoryId}}",
  "locationId": "{{locationId}}",
  "vendorId": "{{vendorId}}",
  "serialNumber": "EXAMPLE-SERIAL-001",
  "purchaseDate": "2026-01-15T00:00:00Z",
  "purchasePrice": 1500.00,
  "condition": "Good",
  "status": "Available",
  "notes": "Example asset"
}

### Get asset details and most recent loan
GET {{baseUrl}}/api/v1/assets/{{assetId}}
Authorization: Bearer {{token}}

### Update an asset (Admin or Staff)
PUT {{baseUrl}}/api/v1/assets/{{assetId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Laptop Updated",
  "categoryId": "{{categoryId}}",
  "locationId": "{{locationId}}",
  "vendorId": "{{vendorId}}",
  "serialNumber": "EXAMPLE-SERIAL-001",
  "purchaseDate": "2026-01-15T00:00:00Z",
  "purchasePrice": 1450.00,
  "condition": "MinorDamage",
  "status": "Available",
  "notes": "Updated example asset"
}

### Upload an asset photo (JPG/PNG, max 2 MB; replace the sample image path)
POST {{baseUrl}}/api/v1/assets/{{assetId}}/photo
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=AssetPhotoBoundary

--AssetPhotoBoundary
Content-Disposition: form-data; name="file"; filename="asset-photo.jpg"
Content-Type: image/jpeg

< ./asset-photo.jpg
--AssetPhotoBoundary--

### Export filtered assets to Excel (Admin or Staff)
GET {{baseUrl}}/api/v1/assets/export?status=Available&categoryId={{categoryId}}&locationId={{locationId}}
Authorization: Bearer {{token}}

### List maintenance tickets (Admin/Staff; filter by status and asset)
GET {{baseUrl}}/api/v1/maintenance?status=Reported&assetId={{assetId}}&page=1&pageSize=10&sortBy=reportedAt&sortDir=desc
Authorization: Bearer {{token}}

### Create a maintenance ticket (Admin/Staff; marks the asset as Maintenance)
# @name createMaintenance
POST {{baseUrl}}/api/v1/maintenance
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assetId": "{{assetId}}",
  "description": "Routine inspection",
  "vendorId": "{{vendorId}}"
}

### Update maintenance status, cost, and finish date (Admin/Staff; use complete to set Done)
PUT {{baseUrl}}/api/v1/maintenance/{{maintenanceId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "InProgress",
  "cost": 125.00,
  "finishedAt": "2026-11-25T10:00:00Z"
}

### Complete a maintenance ticket (sets Done and returns the asset to Available)
POST {{baseUrl}}/api/v1/maintenance/{{maintenanceId}}/complete
Authorization: Bearer {{token}}

### Dashboard summary (Admin/Staff)
GET {{baseUrl}}/api/v1/dashboard/summary
Authorization: Bearer {{token}}

### Asset counts by category for dashboard chart (Admin/Staff)
GET {{baseUrl}}/api/v1/dashboard/assets-by-category
Authorization: Bearer {{token}}

### Request a loan (Admin, Staff, or User)
# @name createLoan
POST {{baseUrl}}/api/v1/loans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assetId": "{{assetId}}",
  "dueDate": "2027-01-15T17:00:00Z",
  "purpose": "Project work"
}

### List the current user's loans
GET {{baseUrl}}/api/v1/loans/my?page=1&pageSize=10
Authorization: Bearer {{token}}

### List loans (Admin/Staff; filter by status and separate date fields)
GET {{baseUrl}}/api/v1/loans?status=Pending&requestedFrom=2026-01-01T00:00:00Z&requestedTo=2027-12-31T23:59:59Z&loanFrom=2026-01-01T00:00:00Z&loanTo=2027-12-31T23:59:59Z&dueFrom=2026-01-01T00:00:00Z&dueTo=2027-12-31T23:59:59Z&page=1&pageSize=10
Authorization: Bearer {{token}}

### Get a loan the current user owns, or any loan as Admin/Staff
GET {{baseUrl}}/api/v1/loans/{{loanId}}
Authorization: Bearer {{token}}

### Approve a pending loan (Admin only)
POST {{baseUrl}}/api/v1/loans/{{loanId}}/approve
Authorization: Bearer {{token}}

### Return a loan in good condition (Admin/Staff)
POST {{baseUrl}}/api/v1/loans/{{loanId}}/return
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "returnCondition": "Good"
}

### Create a second request to test rejection
# @name createRejectedLoan
POST {{baseUrl}}/api/v1/loans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assetId": "{{assetId}}",
  "dueDate": "2027-01-15T17:00:00Z",
  "purpose": "Request to be rejected"
}

### Reject a pending loan (Admin only; required reason)
POST {{baseUrl}}/api/v1/loans/{{rejectedLoanId}}/reject
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Asset is required for another project"
}

### Create a third request to test damaged return
# @name createMaintenanceLoan
POST {{baseUrl}}/api/v1/loans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assetId": "{{assetId}}",
  "dueDate": "2027-01-15T17:00:00Z",
  "purpose": "Request for maintenance workflow"
}

### Approve the third loan (Admin only)
POST {{baseUrl}}/api/v1/loans/{{maintenanceLoanId}}/approve
Authorization: Bearer {{token}}

### Return with damage (Admin/Staff; automatically creates a maintenance ticket)
POST {{baseUrl}}/api/v1/loans/{{maintenanceLoanId}}/return
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "returnCondition": "MinorDamage"
}

### List loans overdue by current time (Admin/Staff; status is computed)
GET {{baseUrl}}/api/v1/loans/overdue?page=1&pageSize=10
Authorization: Bearer {{token}}

### Search audit logs by entity, user, and time range (Admin only)
GET {{baseUrl}}/api/v1/audit-logs?entityName=Loan&fromDate=2026-01-01T00:00:00Z&toDate=2027-12-31T23:59:59Z&page=1&pageSize=10
Authorization: Bearer {{token}}

### Soft-delete the example asset (Admin only)
DELETE {{baseUrl}}/api/v1/assets/{{assetId}}
Authorization: Bearer {{token}}
